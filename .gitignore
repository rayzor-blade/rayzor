# Generated by Cargo
# will have compiled files and executables
# (the bare `debug` here used to shadow legacy `cargo build` artifacts,
# but `target/` already excludes them and the bare pattern matches our
# `src/debug/` subcommand module too — keep `target` only)
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Rayzor build artifacts
/target/
*.blade
*.bsym
*.mir.cache

# Haxe platform-specific standard libraries (not needed for Rayzor target)
compiler/haxe-std/cpp/
compiler/haxe-std/cs/
compiler/haxe-std/eval/
compiler/haxe-std/flash/
compiler/haxe-std/hl/
compiler/haxe-std/java/
compiler/haxe-std/js/
compiler/haxe-std/jvm/
compiler/haxe-std/lua/
compiler/haxe-std/neko/
compiler/haxe-std/php/
compiler/haxe-std/python/
# Note: sys/ is NOT ignored - we maintain it for Rayzor runtime

# Cranelift fork (local development only, use git dependency in production)

cranelift-fork/

.claude/

# Benchmark results (generated fresh by CI, local runs should not be committed)
compiler/benchmarks/results/*.json
compiler/benchmarks/charts/*.html

# Thread stress test logs
ci/thread-test/logs/
examples/**/.rayzor/
**/.rayzor/build/

# rayzor-numa rpkg artifact (rebuilt by examples/numa-pool/build.sh)
/numa/*.rpkg

# Python: virtualenvs and caches. Nothing in the build or the runtime needs an
# interpreter -- Python is confined to the Apple CoreML/BNNS graph authors and
# the golden generators, whose environment is recreated from
# nue-plugins/examples/requirements.txt and never committed.
**/mlvenv/
**/.venv/
**/venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# CoreML/BNNS artifacts the graph authors emit. `nue author` writes a
# .mlpackage per sequence bucket and `xcrun coremlc compile` turns each into a
# .mlmodelc; both are build outputs measured in hundreds of MB. The goldens
# under nue/tests/bert/goldens ARE tracked -- they are inputs to the test, not
# outputs of a build -- so nothing here matches .json or .bin.
*.mlpackage/
*.mlmodelc/
*.mlmodel
*.npy
*.npz

# editor backups — never belong in the tree
*.bak
*.bak[0-9]
*.backup

# working plans and handoffs — local only
docs/plans/
nue/plans/

# Generated by run_haxe_tests.sh on every run
test_results.txt
